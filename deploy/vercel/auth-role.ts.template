import {serverConfig,sessionToken,type ChatGPTUser} from './chatgpt-auth';
export async function getWorkspaceRole(_user:ChatGPTUser){
 const config=serverConfig(),token=await sessionToken();if(!config||!token)return 'student';
 try{const response=await fetch(config.issuer+'/api/community',{headers:{'x-nextrole-session':token},cache:'no-store',redirect:'error',signal:AbortSignal.timeout(15000)});if(!response.ok)return 'student';const data=await response.json() as {state?:{role?:string}};return data.state?.role==='host'?'host':'student';}catch{return 'student';}
}

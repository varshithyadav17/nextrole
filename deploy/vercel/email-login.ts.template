import {NextResponse} from 'next/server';
import {serverConfig,sessionToken,SESSION_COOKIE} from '../app/chatgpt-auth';
import {base64url,proof,randomToken,safeReturnPath,issueSession,verifySession,SESSION_SECONDS,type BridgeUser} from './bridge/session';
import {boundedJSON} from './http-json';
import {hashPassword,checkPassword,validPassword,PasswordBusyError} from './password';
import {z} from 'zod';
const security={'Cache-Control':'private, no-store','X-Content-Type-Options':'nosniff','Referrer-Policy':'no-referrer'};
const input=z.object({action:z.enum(['login','signup','link']),email:z.string().trim().toLowerCase().email().max(254),password:z.string().max(128),fullName:z.string().trim().min(1).max(100).optional(),returnTo:z.string().max(1500).optional()});
class AccountError extends Error {status:number;constructor(message:string,status:number){super(message);this.status=status;}}
export function emailReady(){return !!serverConfig()&&process.env.NEXTROLE_EMAIL_ENABLED==='true';}
export async function emailAuth(request:Request){
 const config=serverConfig(),respond=(error:string,status:number)=>Response.json({error},{status,headers:{...security,...(status===429?{'Retry-After':'60'}:{})}});
 if(!config||!emailReady())return respond('Email sign-in is being connected. Please use Google for now.',503);
 if(request.headers.get('origin')!==config.audience)return respond('Start sign-in from NextRole.',403);
 try{
  const value=input.parse(await boundedJSON(request,4096));
  if(!validPassword(value.password,value.action!=='login'))return respond(value.action==='login'?'Enter your email and password.':'Use a password with 12 to 128 characters.',400);
  const previous=value.action==='link'?await sessionToken():null,user=previous?await verifySession(config,previous):null;
  if(value.action==='link'&&(!user||user.email.trim().toLowerCase()!==value.email))return respond('Sign in to this account before adding a password.',401);
  if(value.action!=='login'&&!value.fullName)return respond('Enter your full name.',400);
  async function store(data:Record<string,unknown>){
   const payload=base64url(new TextEncoder().encode(JSON.stringify({...data,issuedAt:Date.now(),requestId:randomToken()})));
   const response=await fetch(config!.storageOrigin+'/api/bridge/email',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({payload,signature:await proof(config!,'email-auth-v1',payload)}),cache:'no-store',redirect:'error',signal:AbortSignal.timeout(20000)});
   if(!response.ok&&![400,401,409,429].includes(response.status)){console.warn('nextrole_auth',{method:'email',stage:'account-store',status:response.status});throw new AccountError('Account sign-in is temporarily unavailable. Please try again.',503);}
   const dataOut=await boundedJSON(response,12000);
   if(!response.ok)throw new AccountError(typeof dataOut.error==='string'?dataOut.error:'Sign-in could not finish.',response.status);
   return dataOut;
  }
  const lookup=await store({action:'lookup',email:value.email});let account:BridgeUser;
  if(value.action==='login'){
   if(!await checkPassword(value.password,lookup.account?.passwordHash||null)||!lookup.account?.user)return respond('Email or password is incorrect. If you joined with Google, use Google to sign in.',401);
   account=lookup.account.user;
  }else{
   if(lookup.account)throw new AccountError('An account already uses these details. Sign in to continue.',409);
   const created=await store({action:'create',email:value.email,fullName:value.fullName,passwordHash:await hashPassword(value.password),previousSession:previous});account=created.user;
  }
  const token=await issueSession(config,account),response=NextResponse.json({ok:true,returnTo:safeReturnPath(value.returnTo||'/')},{headers:security});
  response.cookies.set(SESSION_COOKIE,token,{httpOnly:true,secure:true,sameSite:'lax',path:'/',maxAge:SESSION_SECONDS});return response;
 }catch(error){
  if(error instanceof PasswordBusyError)return respond(error.message,429);
  if(error instanceof AccountError)return respond(error.message,error.status);
  if(error instanceof z.ZodError||error instanceof SyntaxError)return respond('Check your name, email and password, then try again.',400);
  console.warn('nextrole_auth',{method:'email',stage:'request-failed'});
  return respond('Sign-in could not finish. Please try again.',503);
 }
}

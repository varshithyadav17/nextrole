import {cookies} from 'next/headers';
import {redirect} from 'next/navigation';
import {bridgeConfig,verifySession,safeReturnPath,type BridgeUser} from '../lib/bridge/session';
export type ChatGPTUser=BridgeUser;
export const SESSION_COOKIE='__Host-nextrole-session';
export function serverConfig(){return bridgeConfig(process.env.NEXTROLE_BRIDGE_SECRET,process.env.NEXTROLE_BACKEND_ORIGIN,process.env.NEXTROLE_APP_ORIGIN);}
export async function sessionToken(){const config=serverConfig(),token=(await cookies()).get(SESSION_COOKIE)?.value||null;return config&&await verifySession(config,token)?token:null;}
export async function getChatGPTUser():Promise<ChatGPTUser|null>{const config=serverConfig();return config?verifySession(config,(await cookies()).get(SESSION_COOKIE)?.value||null):null;}
export async function requireChatGPTUser(returnTo:string){const user=await getChatGPTUser();if(user)return user;redirect('/login?return_to='+encodeURIComponent(safeReturnPath(returnTo)));}
export function getSignInOptions(){return {googleReady:!!serverConfig()&&typeof process.env.GOOGLE_CLIENT_ID==='string'&&process.env.GOOGLE_CLIENT_ID.endsWith('.apps.googleusercontent.com')&&!!process.env.GOOGLE_CLIENT_SECRET&&process.env.GOOGLE_CLIENT_SECRET.length>=16,googleOnly:false,googleExternal:false,googleOrigin:''};}
export function chatGPTSignInPath(returnTo:string){return '/signin-with-chatgpt?return_to='+encodeURIComponent(safeReturnPath(returnTo));}
export function chatGPTSignOutPath(returnTo='/'){return '/signout-with-chatgpt?return_to='+encodeURIComponent(safeReturnPath(returnTo));}
